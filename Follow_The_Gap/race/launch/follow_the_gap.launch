<launch>
    <!-- Include remote teleop launch -->
    <include file="$(find move_base)/launch/remote_teleop.launch"/>
    
    <!-- Launch the LIDAR processing node -->
    <node pkg="race" type="dist_finder.py" name="dist_finder" output="screen">
        <remap from="scan" to="/car_8/scan"/>
    </node>

    <!-- Launch the control node -->
    <node pkg="race" type="control.py" name="gap_follower" output="screen"/>

    <!-- Launch the visualization node -->
    <node pkg="race" type="rviz_test.py" name="rviz_test" output="screen"/>

    <!-- Launch RViz with custom configuration -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find race)/ftg.rviz" output="screen"/>
</launch>
