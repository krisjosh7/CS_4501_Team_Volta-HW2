<launch>

     
    <!-- ========= ARGS ========= -->
    <!-- Car namespace -->
    <arg name="car_ns"  default="car_8"/>

    <!-- SSH info for the car -->
    <arg name="car_ip"   default="192.168.1.1"/>
    <arg name="car_user" default="nvidia"/>

    <!-- RViz config file -->
    <arg name="rviz_config" default="$(find race)/localization_viz.rviz"/>

    <include file="$(find move_base)/launch/remote_teleop.launch" />



    <!-- 5) RViz with localization config (run locally) -->
    <!-- localization_viz.rviz should live in the package used above in rviz_config -->
    <node pkg="rviz"
          type="rviz"
          name="localization_rviz"
          args="-d $(arg rviz_config)"
          launch-prefix="gnome-terminal -e"
          output="screen" />

    <!-- ========= REMOTE MACHINE (CAR) ========= -->
    <!-- SSH to this machine and start the nodes there -->
    <machine name="car"
             address="$(arg car_ip)"
             user="$(arg car_user)" />

    <node machine="car"
          pkg="roslaunch"
          type="roslaunch"
          name="car_move_base"
          args="move_base move_base.launch listen_offboard:=true"
          output="screen" />

    <node machine="car"
          pkg="roslaunch"
          type="roslaunch"
          name="car_particle_filter"
          args="particle_filter slam.launch.py"
          output="screen" />

    <node machine="car"
          pkg="f1tenth_purepursuit"
          type="pure_pursuit.py"
          name="pure_pursuit"
          args="$(arg car_ns) third_line"
          output="screen" />

    <!-- ========= LOCAL MACHINE ========= -->

    
</launch>
